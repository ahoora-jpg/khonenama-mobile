{
  "expo": {
    "name": "خونه‌نما",
    "slug": "khonenama",
    "scheme": "khonenama",
    "version": "1.2.4",
    "description": "اپ خونه نما برای ثبت و مدیریت کسب‌وکار، دریافت درخواست مشتری و پاسخ‌گویی سریع.",
    "primaryColor": "#AD6039",
    "backgroundColor": "#F1F0EA",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.khonenama.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "ir.khonenama.app",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "برای عکاسی از نمونه‌کارهای کسب‌وکار، دسترسی دوربین لازم است.",
          "photosPermission": "برای انتخاب تصویر نمونه‌کار از گالری گوشی.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "defaultChannel": "business-requests",
          "color": "#176B4D"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "213e1c29-f131-4b49-b9a5-faf0a61eae63"
      }
    },
    "owner": "ahoora1981"
  }
}
